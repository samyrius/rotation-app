{
  "name": "ResiManage 2 test environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "ResiManage test app",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt pytest",
  "postStartCommand": "bash .devcontainer/start-demo.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
